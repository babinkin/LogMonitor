{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ Project",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-pthread",
                "-I${workspaceFolder}",      // Объединяем флаг -I и путь без пробела
                "-I${workspaceFolder}/src",  // Объединяем флаг -I и путь для папки src
                "${workspaceFolder}/src/blocking_queue.cpp", // Перечисляем файлы вручную,
                "${workspaceFolder}/src/main.cpp",           // чтобы избежать проблем со звездочкой
                "-o",
                "${workspaceFolder}/build/app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}